# ==============================================================================
# XORU — EXAMPLE ENVIRONMENT CONFIGURATION (.env.example)
# Safe for version control & GitHub repository. Demo values only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare Infrastructure
# ------------------------------------------------------------------------------
# Persistent API Token from Cloudflare Dashboard (Permissions: Workers, KV, D1)
CLOUDFLARE_API_TOKEN=demo_cf_api_token_xxxxxxxxxxxxxxxxxxxx

# Cloudflare Account ID (Found in Cloudflare Dashboard right sidebar)
CLOUDFLARE_ACCOUNT_ID=demo_cf_account_id_xxxxxxxxxxxxxxxx

# Cloudflare KV Namespace ID for Sub-10ms Global Redirection Cache
CLOUDFLARE_KV_NAMESPACE_ID=demo_kv_namespace_id_xxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 2. Database (Neon Postgres DB)
# ------------------------------------------------------------------------------
# Neon Serverless Postgres Connection String (Pooler URL with SSL)
NEON_DATABASE_URL=postgresql://demo_user:demo_password@ep-demo-123456.neon.tech/xoru_db?sslmode=require

# ------------------------------------------------------------------------------
# 3. Authentication (Clerk Auth)
# ------------------------------------------------------------------------------
# Clerk Publishable Key (Frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZGVtby1jbGVyay1rZXktMTIzNDU2Nw

# Clerk Secret Key (Backend JWT Verification & Tenant Org Management)
CLERK_SECRET_KEY=sk_test_ZGVtby1jbGVyay1zZWNyZXQtMTIzNDU2Nzg5

# ------------------------------------------------------------------------------
# 4. App Endpoints & Environment Mode
# ------------------------------------------------------------------------------
ENVIRONMENT=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:8787

